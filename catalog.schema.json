{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentD Next recommended Skills",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "groups", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "group", "author", "source", "licence", "reviewedAt", "agents"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "description": { "type": "string", "maxLength": 200 },
          "group": { "type": "string", "description": "A group id from `groups`." },
          "author": { "type": "string" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "path", "sha"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://", "description": "The Skill's git repository." },
              "path": { "type": "string", "description": "The Skill's folder in that repository." },
              "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "The reviewed commit. Only this commit is installed." }
            }
          },
          "licence": { "type": "string", "description": "SPDX identifier of the Skill's licence at the reviewed commit." },
          "reviewedAt": { "type": "string", "format": "date" },
          "agents": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["claude", "codex"] }
          }
        }
      }
    }
  }
}
